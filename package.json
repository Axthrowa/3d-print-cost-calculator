{
  "name": "3d-print-cost-calculator",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "description": "3D Yazici Baski Maliyeti Hesaplayici",
  "scripts": {
    "dev": "tauri dev",
    "build": "node packaging/build-server-parser.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,js}\"",
    "serve": "node server/server.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "exe": "npm run build && node packaging/build-exe.mjs",
    "exe:sign": "powershell -ExecutionPolicy Bypass -File packaging/sign-exe.ps1",
    "yonetici": "node packaging/yonetici-araci.mjs",
    "dev:web": "vite",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "build:desktop": "npm run build && tauri build && node packaging/copy-desktop.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
